# Create provider keys in GroqCloud and Google AI Studio, then set them locally.
# Groq is the default with an automatic 120B-to-20B fallback.
# Gemini remains available as a direct selection when its key is configured.
# Do not commit real keys to version control.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
